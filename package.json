{
  "name": "@ekil9/dsh-tui",
  "version": "0.1.0-mvp.0",
  "description": "Inline terminal UI for DeepSeek Harness, powered by eye_declare",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "trustedDependencies": ["@deepseek-ai/dsh-subprocess-local", "node-pty"],
  "license": "MIT",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./startup": { "types": "./dist/startup.d.ts", "default": "./dist/startup.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "cordis.patch.yml", "native/Cargo.toml", "native/Cargo.lock", "native/build.rs", "native/src", "native/vendor", "scripts/build-native.mjs"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "dev": "bun run build && bun run dsh --profile tui",
    "build": "tsc && bun run build:native",
    "build:native": "bun scripts/build-native.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:pty": "bun run build && node --test --test-concurrency=1 test/pty.mjs",
    "test:install": "bun run build && node --test test/install.mjs",
    "install": "node scripts/build-native.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-presets": "0.1.5-rc.2",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "0.1.5-rc.2",
    "@deepseek-ai/dsh-cordis-host-runner": "0.1.5-rc.2",
    "@deepseek-ai/dsh-host-plugin-inventory": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-ask-user": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "0.1.5-rc.2",
    "commander": "15.0.0",
    "strip-ansi": "7.1.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.2",
    "@deepseek-ai/dsh-cmdline": "0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.5-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.5-rc.2",
    "@types/node": "24.10.0",
    "@xterm/headless": "6.0.0",
    "@xterm/addon-unicode11": "0.9.0",
    "node-pty": "1.1.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
